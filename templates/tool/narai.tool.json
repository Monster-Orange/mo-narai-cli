{
  "id": "{{id}}",
  "version": "0.1.0",
  "sdk": "^1",
  "publisher": { "name": "{{publisher}}", "url": "https://example.com" },
  "surfaces": { "embed": { "url": "https://example.com/{{name}}/", "sdk": "^1" } },
  "payloads": {
    "{{family}}.answer@1": {
      "type": "object",
      "properties": { "text": { "type": "string", "maxLength": 200 } },
      "required": ["text"],
      "additionalProperties": false
    },
    "{{family}}.drill@1": {
      "type": "object",
      "properties": { "rounds": { "type": "integer", "minimum": 0 } },
      "required": ["rounds"]
    }
  },
  "answers": { "{{family}}.say": "{{family}}.answer@1" },
  "practice": { "drill": "{{family}}.drill@1" },
  "assist": "honors",
  "locales": ["en", "ja"],
  "capabilities": { "audio_out": false, "microphone": false, "network": "none" }
}
