{
  "name": "@narai/cli",
  "version": "0.0.0",
  "description": "The narai command: scaffold, validate, build, run and register tools for Narai lessons.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "narai": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "oclif": {
    "bin": "narai",
    "dirname": "narai",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands.js",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " "
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/confirm": "6.3.3",
    "@napi-rs/keyring": "2.1.1",
    "@narai/sdk": "github:Monster-Orange/mo-narai-sdk#b85c963c23c8bee9e8176d4fe1cbee70669da01c",
    "@oclif/core": "5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
