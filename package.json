{
  "name": "@michinarai/cli",
  "version": "0.2.4",
  "description": "The narai command: scaffold, validate, build, run and register tools for Narai lessons.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monster-Orange/mo-narai-cli.git"
  },
  "homepage": "https://github.com/Monster-Orange/mo-narai-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "narai": "bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "oclif": {
    "bin": "narai",
    "dirname": "narai",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/commands.js",
      "identifier": "COMMANDS"
    },
    "topicSeparator": " "
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "generate": "openapi-typescript node_modules/@michinarai/sdk/schema/openapi.tools.json --output src/generated/api.ts"
  },
  "dependencies": {
    "@inquirer/confirm": "6.3.3",
    "@michinarai/sdk": "0.3.4",
    "@napi-rs/keyring": "2.1.1",
    "@oclif/core": "5.1.7",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "14.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
